{
  "name": "rusty-bacnet-docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev",
    "check": "astro check",
    "build": "node scripts/prepare.mjs && astro sync --force && astro build",
    "preview": "astro preview",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e",
    "prepare:content": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "@playwright/test": "1.61.1",
    "playwright-core": "1.61.1",
    "@axe-core/playwright": "^4.11.0"
  }
}
