---
import { release } from '../lib/site.mjs';

// One card per kind of reader, each to the page that starts that path. The
// e2e tests follow every link here, so a path that moves fails there.
const paths = [
  { label: 'EVALUATE', icon: '✓', title: 'Check the scope first.', href: 'project/support/', link: 'What it supports',
    text: 'What the stack implements, what is tested and what it doesn\'t claim, before you plan a deployment.' },
  { label: 'PYTHON', icon: 'py', title: 'Script it with asyncio.', href: 'start/python/', link: 'Read with Python',
    text: 'Install the package and read a property from a short script with typed values.' },
  { label: 'RUST', icon: 'rs', title: 'Build it into your system.', href: 'start/rust/', link: 'Start with Rust',
    text: 'Add the client crates to a Tokio application and read a property from a known device.' },
  { label: 'CLI AND TERMINAL UI', icon: '>_', title: 'Work from the terminal.',
    links: [{ href: 'start/first-read/', link: 'One-shot commands' }, { href: 'tui/overview/', link: 'The terminal UI' }],
    text: 'Read a known device with one-shot commands, or browse, watch and write in the full-screen terminal UI.' },
  { label: 'EMBEDDED', icon: 'μc', title: 'Run on a microcontroller.', href: 'start/embedded/', link: 'Run on firmware',
    text: 'Portable no_std cores for MS/TP, BACnet/IP and routing, with no allocator.' },
  { label: 'NO CONTROLLER?', icon: '127', title: 'Start on your own machine.', href: 'start/local-lab/', link: 'Try the local lab',
    text: 'A client and an example server on loopback addresses. Nothing leaves the host.' },
];
const more = [
  { href: 'connect/overview/', title: 'Connect to a network', text: 'BACnet/IP, BBMDs, BACnet/SC, MS/TP and IPv6' },
  { href: 'guides/discovery/', title: 'Discover devices', text: 'Directed and broadcast Who-Is, BBMDs and routed targets' },
  { href: 'integrate/overview/', title: 'Build applications', text: 'Servers, routers, shared endpoints and policies' },
  { href: 'tui/overview/', title: 'Terminal UI', text: 'Every screen of the full-screen browser' },
  { href: 'reference/api/', title: 'Reference', text: 'Rust crates, the Python API and CLI commands' },
  { href: 'help/troubleshooting/', title: 'Troubleshooting', text: 'From the symptom to the next check' },
];
const base = '/rusty-bacnet/';
---
<div class="rb-home">
  <section aria-labelledby="paths-title" class="rb-section">
    <div class="rb-section-heading"><div><p class="rb-eyebrow">RELEASE v{release}</p><h2 id="paths-title">Start where you are.</h2></div><a href={`${base}start/installation/`}>Install v{release} <span aria-hidden="true">→</span></a></div>
    <ul class="rb-journey-grid" role="list">
      {paths.map(path => (
        <li>{path.links
          ? <div class="rb-journey"><span class="rb-card-icon" aria-hidden="true">{path.icon}</span><span class="rb-card-label">{path.label}</span><h3>{path.title}</h3><p>{path.text}</p><span class="rb-card-links">{path.links.map(item => <a class="rb-card-link" href={base + item.href}>{item.link} <span aria-hidden="true">→</span></a>)}</span></div>
          : <a class="rb-journey" href={base + path.href}><span class="rb-card-icon" aria-hidden="true">{path.icon}</span><span class="rb-card-label">{path.label}</span><h3>{path.title}</h3><p>{path.text}</p><span class="rb-card-link">{path.link} <span aria-hidden="true">→</span></span></a>}</li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="more-title" class="rb-section">
    <h2 id="more-title" class="rb-more-title">Then go further.</h2>
    <ul class="rb-more" role="list">
      {more.map(item => (
        <li><a href={base + item.href}><strong>{item.title}</strong><small>{item.text}</small></a></li>
      ))}
    </ul>
  </section>
  <aside class="rb-dev-note" aria-labelledby="dev-title"><div><strong id="dev-title">Coming in 0.15, on <code>dev</code> now</strong><p>An MCP server that lets an AI agent host read a BACnet site and, only where a profile allows it, make writes a person approves. The prebuilt downloads include it from 0.15; source builds enable it with <code>--features mcp</code>.</p></div><a href={`${base}guides/ai-agents/`}>AI agents (MCP) <span aria-hidden="true">→</span></a></aside>
  <p class="rb-home-contribute">Working on Rusty BACnet itself? <a class="rb-text-link" href={`${base}development/build-from-source/`}>Build from source</a> · <a class="rb-text-link" href={`${base}development/documentation/`}>Improve the documentation</a></p>
  <p class="rb-footnote">Rusty BACnet is an MIT-licensed protocol stack. It targets ASHRAE Standard 135-2020 and isn't BTL certified. Pre-1.0: APIs change between minor releases. Work only on networks you are authorized to access.</p>
</div>
