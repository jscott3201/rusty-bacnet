{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jscott3201/rusty-bacnet/benchmarks/schema/benchmark-result.schema.json",
  "title": "Rusty BACnet benchmark result row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite",
    "scenario",
    "command",
    "repo_sha",
    "ref",
    "environment",
    "metrics"
  ],
  "properties": {
    "suite": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "repo_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "ref": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["os", "rustc", "cargo"],
      "properties": {
        "os": { "type": "string" },
        "cpu": { "type": "string" },
        "memory": { "type": "string" },
        "rustc": { "type": "string" },
        "cargo": { "type": "string" },
        "python": { "type": "string" },
        "docker": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_secs": { "type": "number", "minimum": 0 },
        "warmup_secs": { "type": "number", "minimum": 0 },
        "p50_us": { "type": "number", "minimum": 0 },
        "p95_us": { "type": "number", "minimum": 0 },
        "p99_us": { "type": "number", "minimum": 0 },
        "p999_us": { "type": "number", "minimum": 0 },
        "max_us": { "type": "number", "minimum": 0 },
        "throughput_ops_sec": { "type": "number", "minimum": 0 },
        "total_operations": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "timeouts": { "type": "integer", "minimum": 0 },
        "drops": { "type": "integer", "minimum": 0 },
        "peak_rss_kb": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "string" }
  }
}
