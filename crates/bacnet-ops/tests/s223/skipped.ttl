# EXPERIMENTAL: device 1234 as a proposed ASHRAE Standard 223 point list, written by
# rusty-bacnet. The 223 draft and this mapping can change between releases.
# A point list only: it holds no equipment, connections or sensors.
# Checked against the Open223 ontology git:master@6fdc11c6 (2026-10-06) from https://open223.info/223p.ttl.
# 1 object exported, 2 skipped, 0 with an unmapped unit, 0 identifiers left out for instance 0.
# Incomplete: the reading stopped early (analog-input,9: timeout?@prefix).

@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix d: <http://example.org/bacnet/device-1234/> .

# analog-input 1: skipped, its read failed.

# trend-log 1: skipped, its type isn't mapped.

# binary-input 2
d:binary-input-2.present-value a s223:EnumeratedObservableProperty ;
    rdfs:label "Filter Alarm" ;
    s223:hasEnumerationKind s223:Binary-Logical ;
    s223:hasExternalReference d:binary-input-2.present-value.ref .

d:binary-input-2.present-value.ref a s223:BACnetExternalReference ;
    bacnet:device-identifier "device,1234" ;
    bacnet:device-name "AHU-1 Controller" ;
    bacnet:object-identifier "binary-input,2" ;
    bacnet:object-name "Filter Alarm" ;
    bacnet:property-identifier "present-value" .

