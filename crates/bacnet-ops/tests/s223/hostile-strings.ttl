# EXPERIMENTAL: device 1234 as a proposed ASHRAE Standard 223 point list, written by
# rusty-bacnet. The 223 draft and this mapping can change between releases.
# A point list only: it holds no equipment, connections or sensors.
# Mapping written against the Open223 ontology git:master@6fdc11c6 (2026-10-06) from
# https://open223.info/223p.ttl; rusty-bacnet's golden exports were validated against it.
# 2 objects exported, 0 skipped, 0 with an unmapped unit, 0 identifiers left out for instance 0.
# 1 NUL character in device text written as U+FFFD.

@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix d: <http://example.org/bacnet/device-1234/> .

# analog-input 9
d:analog-input-9.present-value a s223:QuantifiableObservableProperty ;
    rdfs:label "Say \"hi\" \\ to\nRoom\t101\u0007\u001B[2J" ;
    rdfs:comment "Temp\u00E9rature \u202Eevil\u2066 \U0001F525\uFFFD" ;
    qudt:hasUnit unit:DEG_C ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    s223:hasExternalReference d:analog-input-9.present-value.ref .

d:analog-input-9.present-value.ref a s223:BACnetExternalReference ;
    bacnet:device-identifier "device,1234" ;
    bacnet:device-name "Bldg \u2028\"B\" \\ \uFEFF" ;
    bacnet:object-identifier "analog-input,9" ;
    bacnet:object-name "Say \"hi\" \\ to\nRoom\t101\u0007\u001B[2J" ;
    bacnet:property-identifier "present-value" .

# multi-state-input 4
d:multi-state-input-4.states a s223:Class, d:multi-state-input-4.states ;
    rdfs:subClassOf s223:EnumerationKind ;
    rdfs:label "Mode \"A\" states" .
d:multi-state-input-4.states.1 a s223:Class, d:multi-state-input-4.states.1 ;
    rdfs:subClassOf d:multi-state-input-4.states ;
    rdfs:label "\"off\" ." .
d:multi-state-input-4.states.2 a s223:Class, d:multi-state-input-4.states.2 ;
    rdfs:subClassOf d:multi-state-input-4.states ;
    rdfs:label "on\r\n# not a comment" .

d:multi-state-input-4.present-value a s223:EnumeratedObservableProperty ;
    rdfs:label "Mode \"A\"" ;
    s223:hasEnumerationKind d:multi-state-input-4.states ;
    s223:hasExternalReference d:multi-state-input-4.present-value.ref .

d:multi-state-input-4.present-value.ref a s223:BACnetExternalReference ;
    bacnet:device-identifier "device,1234" ;
    bacnet:device-name "Bldg \u2028\"B\" \\ \uFEFF" ;
    bacnet:object-identifier "multi-state-input,4" ;
    bacnet:object-name "Mode \"A\"" ;
    bacnet:property-identifier "present-value" .

