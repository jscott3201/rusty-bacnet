# EXPERIMENTAL: device 1234 as a proposed ASHRAE Standard 223 point list, written by
# rusty-bacnet. The 223 draft and this mapping can change between releases.
# A point list only: it holds no equipment, connections or sensors.
# Checked against the Open223 ontology git:master@6fdc11c6 (2026-10-06) from https://open223.info/223p.ttl.
# 1 object exported, 0 skipped, 0 with an unmapped unit, 0 identifiers left out for instance 0.

@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix d: <http://example.org/bacnet/device-1234/> .

# multi-state-value 2
d:multi-state-value-2.states a s223:Class, d:multi-state-value-2.states ;
    rdfs:subClassOf s223:EnumerationKind ;
    rdfs:label "Fan Mode states" .
d:multi-state-value-2.states.1 a s223:Class, d:multi-state-value-2.states.1 ;
    rdfs:subClassOf d:multi-state-value-2.states ;
    rdfs:label "Off" .
d:multi-state-value-2.states.2 a s223:Class, d:multi-state-value-2.states.2 ;
    rdfs:subClassOf d:multi-state-value-2.states ;
    rdfs:label "state 2" .
d:multi-state-value-2.states.3 a s223:Class, d:multi-state-value-2.states.3 ;
    rdfs:subClassOf d:multi-state-value-2.states ;
    rdfs:label "High" .

d:multi-state-value-2.present-value a s223:EnumeratedActuatableProperty ;
    rdfs:label "Fan Mode" ;
    s223:hasEnumerationKind d:multi-state-value-2.states ;
    s223:hasExternalReference d:multi-state-value-2.present-value.ref .

d:multi-state-value-2.present-value.ref a s223:BACnetExternalReference ;
    bacnet:device-identifier "device,1234" ;
    bacnet:device-name "AHU-1 Controller" ;
    bacnet:object-identifier "multi-state-value,2" ;
    bacnet:object-name "Fan Mode" ;
    bacnet:property-identifier "present-value" .

