        sh:NodeShape ;
    rdfs:label "Earth" ;
    rdfs:comment "`Electricity-Earth`" ;
    rdfs:subClassOf s223:Constituent-Electricity .

s223:Electricity-Neutral a s223:Class,
        s223:Electricity-Neutral,
