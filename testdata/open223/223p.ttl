s223:VoltageSensor a s223:Class,
        sh:NodeShape ;
    rdfs:label "Voltage sensor" ;
    rdfs:comment "A `Sensor` that `observes` a `QuantifiableObservableProperty` that represents a measure of voltage." ;
    rdfs:subClassOf s223:Sensor ;
    sh:property [ rdfs:comment "A `VoltageSensor` shall always observe a `QuantifiableObservableProperty` that has a `QuantityKind` of Voltage." ;
            sh:class s223:QuantifiableObservableProperty ;
            sh:message "s223: A `VoltageSensor` shall always observe a `QuantifiableObservableProperty` that has a `QuantityKind` of Voltage." ;
            sh:node [ sh:property [ sh:in ( quantitykind:Voltage ) ;
                            sh:path qudt:hasQuantityKind ] ] ;
            sh:path s223:observes ] .

s223:Water-ChilledWater a s223:Class,
        s223:Water-ChilledWater,
        sh:NodeShape ;
    rdfs:label "Chilled water" ;
    s223:composedOf [ a s223:QuantifiableProperty ;
            rdfs:label "Water concentration" ;
            s223:ofConstituent s223:Constituent-H2O ;
            qudt:hasQuantityKind quantitykind:VolumeFraction ;
            qudt:hasUnit unit:PERCENT ] ;
    rdfs:comment "Water-Chilled water" ;
    rdfs:subClassOf s223:Fluid-Water .

