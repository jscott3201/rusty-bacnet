# Tool pins for the GitHub workflows: ci.yml (Linux), native-tests.yml (macOS
# and Windows), fuzz.yml and release.yml. The Rust toolchain itself is pinned
# in rust-toolchain.toml, which every workflow but fuzz.yml installs from. See
# docs/ci.md.
#
# One NAME=value per line; values are plain version strings, toolchain names
# or hex digests. ci.yml's Lint job checks the format (each *_SHA256 is 64
# lowercase hex digits, RUST_FUZZ_NIGHTLY a dated nightly), and that RUST_MSRV
# matches Cargo.toml's rust-version and scripts/ci/check-msrv.sh.
#
# Each *_SHA256 is the digest of what the comment above it names; update it
# with its version. The CI tools' digests are of the Linux x86_64 release
# archives that scripts/ci/install-tools.sh downloads for ci.yml.
# native-tests.yml reads only the versions: taiki-e/install-action checks
# cargo-nextest's download against its own manifest, and maturin comes from
# PyPI, as it does for release.yml's builds.

# The MSRV toolchain the MSRV job installs.
RUST_MSRV=1.95

# The nightly that builds the fuzz targets (fuzz.yml and
# scripts/ci/fuzz.sh): cargo-fuzz needs nightly-only flags. Its rustc is
# 1.99.0-nightly, the version rust-toolchain.toml pins.
RUST_FUZZ_NIGHTLY=nightly-2026-08-15

# The Python that native-tests.yml sets up (ci.yml uses Ubuntu 24.04's, 3.12).
PYTHON_VERSION=3.12

# cargo-nextest-<version>-x86_64-unknown-linux-gnu.tar.gz
NEXTEST_VERSION=0.9.146
NEXTEST_SHA256=682c21b777c333e96fd532e114d3a5a894e0729ab88d94c0a9f20f8419695428

# cargo-deny-<version>-x86_64-unknown-linux-musl.tar.gz
CARGO_DENY_VERSION=0.20.2
CARGO_DENY_SHA256=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f

# cargo-audit-x86_64-unknown-linux-musl-v<version>.tgz
CARGO_AUDIT_VERSION=0.22.2
CARGO_AUDIT_SHA256=7fb9497f8594b389e5fce5ef9b92db08432996895b2e0c5a0167a69ed445c428

# maturin-x86_64-unknown-linux-musl.tar.gz
MATURIN_VERSION=1.15.0
MATURIN_SHA256=5a7d5226e83598b0c85881a0a03be16393ee2c0924b6f9d752951795825ac806

# cargo-fuzz-<version>-x86_64-unknown-linux-musl.tar.gz, for fuzz.yml
CARGO_FUZZ_VERSION=0.13.2
CARGO_FUZZ_SHA256=b5b704018b63e0f151c17a057ac53b5111e1db545d1b9f72fee79f08a545931c

# Release builds (release.yml, scripts/release/build_linux.sh). The Linux
# artifacts build in the manylinux2014 image (CentOS 7, glibc 2.17), pinned by
# the digest of quay.io/pypa/manylinux2014_<arch> (tag 2026.10.03-1).
MANYLINUX2014_X86_64_SHA256=ffd6d1f11237599748657996b750db6b3a5b724fea5a81cd9ea65add4f45b6c9
MANYLINUX2014_AARCH64_SHA256=9026a55e05e76ad74d9a4e6be814a5abda26cde08b1baa659ea4f7ee16b246e3

# rustup-init for <arch>-unknown-linux-gnu, which installs the toolchain in
# that image.
RUSTUP_VERSION=1.29.1
RUSTUP_X86_64_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
RUSTUP_AARCH64_SHA256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433

# libpcap-<version>.tar.xz from tcpdump.org, which the Linux CLI links
# statically. Track its security fixes by hand: cargo-audit doesn't cover it.
LIBPCAP_VERSION=1.10.7
LIBPCAP_SHA256=68fa62cffb974f4275641ce14c2e2d75739251f30e00e6a0900903b247d76a03
